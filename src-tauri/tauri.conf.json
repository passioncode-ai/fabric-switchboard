{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fabric Switchboard",
  "version": "0.6.11",
  "identifier": "ai.passioncode.fabric-switchboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fabric Switchboard",
        "width": 1180,
        "height": 820,
        "minWidth": 740,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "publisher": "PassionCode.ai",
    "copyright": "Copyright © 2026 Siarhei Sheleh · PassionCode.ai",
    "homepage": "https://passioncode.ai/switchboard/",
    "license": "AGPL-3.0-only OR LicenseRef-PassionCode-Commercial",
    "licenseFile": "../LICENSE",
    "shortDescription": "Local account switching for Claude Code and Codex CLI",
    "longDescription": "Fabric Switchboard keeps several Claude Code and Codex CLI accounts on one machine, stores their credentials in the native vault and lets you choose which account handles the next request, launch isolated or managed sessions and watch quota. Open source under the GNU AGPL-3.0; a commercial license is available. Part of the PassionCode.ai toolkit.",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3MTg1MDlCMTQ0MUI4OTcKUldTWHVFRVVtMUFZNXc5Ny9aeHFHYmFLdUhBVU9lRG4vVzlGZ3VUR1hVd0hueWtXL1FFdG1WT0QK",
      "endpoints": [
        "https://github.com/passioncode-ai/fabric-switchboard/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
